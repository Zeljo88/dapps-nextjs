[Unit]
Description=DappsOnCardano private analytics API and preview
After=network.target

[Service]
User=azureuser
WorkingDirectory=/home/azureuser/dapps-analytics/backend
Environment=PYTHONPATH=/home/azureuser/dapps-analytics/vendor
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=ANALYTICS_DB=/mnt/cardano-data/dapps-analytics/analytics-v2.sqlite3
ExecStart=/usr/bin/python3 -m uvicorn analytics.api:create_app --factory --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=10
MemoryMax=512M
CPUQuota=50%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/mnt/cardano-data/dapps-analytics

[Install]
WantedBy=multi-user.target
