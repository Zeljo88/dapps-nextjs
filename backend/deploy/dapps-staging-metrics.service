[Unit]
Description=DappsOnCardano staging read-only own-data metrics
After=network.target

[Service]
User=azureuser
WorkingDirectory=/home/azureuser/dapps-analytics/staging-metrics-runtime
Environment=PYTHONPATH=/home/azureuser/dapps-analytics/vendor
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=ANALYTICS_DB=/mnt/cardano-data/dapps-analytics/analytics-v3.sqlite3
Environment=ANALYTICS_HISTORY=/mnt/cardano-data/dapps-analytics/history
ExecStart=/usr/bin/python3 -m uvicorn analytics.insights:create_app --factory --host 127.0.0.1 --port 8002 --workers 1
Restart=on-failure
RestartSec=10
MemoryMax=256M
CPUQuota=25%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# SQLite read-only WAL connections coordinate through transient shared memory.
# The application still opens the database with mode=ro and query_only=ON.
ReadWritePaths=/mnt/cardano-data/dapps-analytics

[Install]
WantedBy=multi-user.target
