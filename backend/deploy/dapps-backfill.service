[Unit]
Description=Validated Cardano epoch 664 historical trial
After=dapps-ogmios.service dapps-api.service
Requires=dapps-ogmios.service

[Service]
Type=oneshot
User=azureuser
WorkingDirectory=/home/azureuser/dapps-analytics/backfill-summary-runtime
Environment=PYTHONPATH=/home/azureuser/dapps-analytics/vendor:/home/azureuser/dapps-analytics/backfill-summary-runtime
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -u -m analytics.backfill --root /mnt/cardano-data/dapps-analytics/history --epochs 664 --rate 100
Nice=10
CPUQuota=100%
MemoryMax=1G
IOWeight=10
TasksMax=128
TimeoutStartSec=infinity
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/mnt/cardano-data/dapps-analytics/history
