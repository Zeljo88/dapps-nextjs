[Unit]
Description=Snapshot DApp analytics SQLite database

[Service]
Type=oneshot
User=azureuser
ExecStart=/usr/bin/python3 /home/azureuser/dapps-analytics/backend/deploy/backup.py
UMask=0027
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/mnt/cardano-data/dapps-analytics
